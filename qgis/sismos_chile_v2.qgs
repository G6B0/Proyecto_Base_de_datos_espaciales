      <layer-tree-layer patch_size="-1,-1" name="Mw ≥ 7: línea a zona urbana" legend_split_behavior="0" checked="Qt::Checked" expanded="1" source="dbname='sismos_chile' host=127.0.0.1 port=5433 user='sismos_app' key='id' srid=4326 type=LineString checkPrimaryKeyUnicity='1' table=&quot;(&#xa;        SELECT e.earthquake_event_id AS id, e.occurred_at, e.mw_homogenized, u.name AS ciudad,&#xa;               l.epicentral_distance_km,&#xa;               ST_MakeLine(e.geom, ST_ClosestPoint(u.geom, e.geom)) AS geom&#xa;        FROM seismic.event_urban_area l&#xa;        JOIN seismic.earthquake_event e USING (earthquake_event_id)&#xa;        JOIN seismic.urban_area u USING (urban_area_id)&#xa;        WHERE l.distance_rank = 1 AND e.mw_homogenized >= 7)&quot; (geom)" providerKey="postgres" legend_exp="" id="Mw___7__l_nea_a_zona_urbana_8a3044cb_7091_4747_ad14_d253f4b87af9">
