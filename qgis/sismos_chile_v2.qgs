      <id>Ciudades__sismos_Mw___5_a___100_km_9ac55301_b2c4_44a0_ad0b_84023227fa78</id>
      <datasource>dbname='sismos_chile' host=127.0.0.1 port=5433 user='sismos_app' key='urban_area_id' srid=4326 type=MultiPolygon checkPrimaryKeyUnicity='1' table="(
        SELECT u.urban_area_id, u.name, u.category, u.population,
               count(e.earthquake_event_id) AS sismos_mw5_100km, u.geom
        FROM seismic.urban_area u
        LEFT JOIN seismic.event_urban_area l
               ON l.urban_area_id = u.urban_area_id AND l.hypocentral_distance_km &lt;= 100
        LEFT JOIN seismic.earthquake_event e
               ON e.earthquake_event_id = l.earthquake_event_id AND e.mw_homogenized >= 5
        GROUP BY u.urban_area_id)" (geom)</datasource>
