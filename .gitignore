.env
.postgres-data/
.postgres-logs/
__pycache__/
*.py[cod]

# Datos descargados y productos generados. Se recrean con los scripts.
data/raw/
data/processed/
data/diagnostics/
data/README.md

# Solo se publican los scripts que pertenecen al proyecto de sismos.
scripts/*
!scripts/download_csn_catalog.py
!scripts/download_usgs_earthquakes.py
!scripts/run_csn_catalog_qgis.cmd
!scripts/run_usgs_earthquakes_qgis.cmd
!scripts/start_local_postgis.ps1
!scripts/stop_local_postgis.ps1
!scripts/load_catalogs_postgis.ps1
!scripts/load_dpa_postgis.ps1
!scripts/validate_ml_conversion.py
!scripts/load_ine_manzanas_postgis.ps1
!scripts/build_qgis_project.py
!scripts/build_drawio_model.py
!scripts/render_ui_basemap.py
!scripts/render_ui_modes.py
!scripts/plot_declustering.py

# Respaldos de QGIS y carpetas temporales de herramientas.
*.qgs~
.codex_tmp/

# Respaldos de la base (pg_dump): se comparten por Drive, no por Git.
*.dump

# Salidas geoespaciales y logs locales.
*.gpkg
*.tif
*.tiff
*.h5
*.log

# Archivos temporales de Superdesign.
.superdesign/tmp/

# Entorno de Python de la interfaz.
app/.venv/
